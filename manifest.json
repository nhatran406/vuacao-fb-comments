{
  "manifest_version": 3,
  "name": "SocialPulse AI - Social Intelligence & Sentiment Scraper",
  "version": "1.0.0",
  "description": "Nền tảng tự động tìm kiếm, thu thập bài viết và phân tích sắc thái bình luận (Social Sentiment & Market Intelligence) đa luồng trên Facebook.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SocialPulse AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.fb.com/*",
    "*://*.fb.watch/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.fb.com/*",
        "*://*.fb.watch/*"
      ],
      "js": [
        "content/page-unthrottler.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.fb.com/*",
        "*://*.fb.watch/*"
      ],
      "js": [
        "utils/exporter.js",
        "content/dom-selectors.js",
        "content/crawler-engine.js",
        "content/hud-widget.js",
        "content/content.js"
      ],
      "css": [
        "content/hud-widget.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.facebook.com/search/*"
      ],
      "js": [
        "content/search/search-scraper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "content/page-unthrottler.js",
        "content/hud-widget.css",
        "dashboard/*"
      ],
      "matches": [
        "*://*.facebook.com/*",
        "*://*.fb.com/*",
        "*://*.fb.watch/*"
      ]
    }
  ]
}