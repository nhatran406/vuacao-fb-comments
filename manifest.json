{
  "manifest_version": 3,
  "name": "FB Post & Comments Scraper - C\u00e0o B\u00e0i Vi\u1ebft & B\u00ecnh Lu\u1eadn FB",
  "version": "1.0.0",
  "description": "T\u1ef1 \u0111\u1ed9ng c\u00e0o n\u1ed9i dung b\u00e0i vi\u1ebft v\u00e0 to\u00e0n b\u1ed9 b\u00ecnh lu\u1eadn/ph\u1ea3n h\u1ed3i Facebook t\u1eeb \u0111\u01b0\u1eddng link. H\u1ed7 tr\u1ee3 xu\u1ea5t JSON v\u00e0 CSV UTF-8.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FB Post & Comments Scraper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.fb.com/*",
    "*://*.fb.watch/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.fb.com/*",
        "*://*.fb.watch/*"
      ],
      "js": [
        "content/page-unthrottler.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.fb.com/*",
        "*://*.fb.watch/*"
      ],
      "js": [
        "utils/exporter.js",
        "content/dom-selectors.js",
        "content/crawler-engine.js",
        "content/hud-widget.js",
        "content/content.js"
      ],
      "css": [
        "content/hud-widget.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.facebook.com/search/*"
      ],
      "js": [
        "content/search/search-scraper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "content/page-unthrottler.js",
        "content/hud-widget.css",
        "dashboard/*"
      ],
      "matches": [
        "*://*.facebook.com/*",
        "*://*.fb.com/*",
        "*://*.fb.watch/*"
      ]
    }
  ]
}